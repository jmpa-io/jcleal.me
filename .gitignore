# ignore general files.
.DS_Store
.vscode/
node_modules/

# ignore generated files.
/out
package.yml
coverage.*
dist/
public/
*.zip
*.pem
traces.txt

# ignore test files.
/test.sh

# ignore compiled binaries in root.
/main

# ignore hugo build lock.
/.hugo_build.lock

# ignore hugo generated resources.
/resources/
static/pdf/

# ignore e2e artifacts.
e2e/node_modules
e2e/test-results
e2e/playwright-report
e2e/screenshots/
